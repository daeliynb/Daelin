## POST HOC POWER ANALYSIS FOR BINOMIAL OUTCOMES
from statsmodels.stats.power import NormalIndPower
from statsmodels.stats.proportion import proportion_effectsize

power_analysis = NormalIndPower()

def run_two_proportion_power_analysis(df, factor, success_col, total_col, metric_name,
                                      alpha=0.05, target_power=0.80):
    results = []

    levels = df[factor].dropna().unique()

    for level in levels:
        group_a = df[df[factor] == level]
        group_b = df[df[factor] != level]

        # TOTALS
        success_a = group_a[success_col].sum()
        total_a = group_a[total_col].sum()

        success_b = group_b[success_col].sum()
        total_b = group_b[total_col].sum()

        if total_a == 0 or total_b == 0:
            continue

        prop_a = success_a / total_a
        prop_b = success_b / total_b
        diff = prop_a - prop_b

        # EFFECT SIZE (H)
        effect_size = proportion_effectsize(prop_a, prop_b)

        # RATIO FOR POWER CALCULATION
        ratio = total_b / total_a if total_a > 0 else np.nan

        if np.isclose(effect_size, 0):
            observed_power = np.nan
            required_n = np.nan
        else:
            observed_power = power_analysis.power(
                effect_size=abs(effect_size),
                nobs1=total_a,
                alpha=alpha,
                ratio=ratio,
                alternative='two-sided'
            )

            required_n = power_analysis.solve_power(
                effect_size=abs(effect_size),
                power=target_power,
                alpha=alpha,
                ratio=1.0,
                alternative='two-sided'
            )

        results.append({
            "Factor": factor,
            "Treatment Level": level,
            "Metric": metric_name,

            "Successes_A": success_a,
            "Total_A": total_a,
            "Proportion_A": prop_a,

            "Successes_B": success_b,
            "Total_B": total_b,
            "Proportion_B": prop_b,

            "Difference (A-B)": diff,
            "Abs_Difference": abs(diff),

            "Effect_Size_Cohens_h": abs(effect_size),
            "Observed_Power": observed_power,
            "Required_n_per_group_80pct_power": np.ceil(required_n) if pd.notna(required_n) else np.nan
        })

    return pd.DataFrame(results)


## FACTORS THAT CONTRIBUTED TO GROWTH

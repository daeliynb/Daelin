## RUN ANALYSIS
all_results = []

## TAKES GROWTH FACTORS AND RUNS ANALYSIS
for factor in growth_factors:
    res = run_two_proportion_power_analysis(
        df=df,
        factor=factor,
        success_col=COL_GROWTH,
        total_col=COL_TOTAL,
        metric_name="Growth"
    )
    all_results.append(res)

# TAKES CONTAMINATION FACTORS AND RUNS ANALYSIS
for factor in contam_factors:
    res = run_two_proportion_power_analysis(
        df=df,
        factor=factor,
        success_col=COL_CONTAM,
        total_col=COL_TOTAL,
        metric_name="Contamination"
    )
    all_results.append(res)

## COMBINE INTO ONE TABLE
power_analysis_summary = pd.concat(all_results, ignore_index=True)

## SORTS BY COMBINING METRIC FIRST (CONTAMINATION VS GROWTH) THEN BY FACTOR
power_analysis_summary = power_analysis_summary.sort_values(
    by=["Metric", "Factor", "Required_n_per_group_80pct_power"],
    ascending=[True, True, False]
).reset_index(drop=True)

## SAVE SINGLE CSV WITH POWER ANALYSIS
power_analysis_summary.to_csv("Posthoc_Power_Analysis.csv", index=False)


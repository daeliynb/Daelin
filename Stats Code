## UNWEIGHTED SUMMARY STATS
def summarize_by_factor(df, factor, value_col, metric_name):
    summary = (
        df.groupby(factor)[value_col]
        .agg(
            replicates="count",
            mean="mean",
            median="median",
            std="std",
            min="min",
            max="max"
        )
        .reset_index()
    )

    summary = summary.rename(columns={factor: "level"})
    summary.insert(0, "factor", factor)
    summary.insert(1, "metric", metric_name)
    summary = summary.sort_values(by="mean", ascending=False).reset_index(drop=True)

    return summary

## WEIGHTED SUMMARY STATS
def summarize_weighted_by_factor(df, factor, metric_name):
    summary = (
        df.groupby(factor)
        .agg(
            replicates=(COL_TOTAL, "count"),
            total_plants=(COL_TOTAL, "sum"),
            total_growth=(COL_GROWTH, "sum"),
            total_contam=(COL_CONTAM, "sum"),
            growth_std=("Growth Rate", "std"),
            contamination_std=("Contamination Rate", "std")
        )
        .reset_index()
    )

    summary["weighted_growth_rate"] = summary["total_growth"] / summary["total_plants"]
    summary["weighted_contamination_rate"] = summary["total_contam"] / summary["total_plants"]

    summary = summary.rename(columns={factor: "level"})
    summary.insert(0, "factor", factor)
    summary.insert(1, "metric", metric_name)

    if metric_name == "Growth Rate":
        summary = summary.sort_values(by="weighted_growth_rate", ascending=False)
    elif metric_name == "Contamination Rate":
        summary = summary.sort_values(by="weighted_contamination_rate", ascending=False)

    summary = summary.reset_index(drop=True)

    return summary

